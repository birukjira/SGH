{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "summit-general-hospital",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "summit-general-hospital",
      "database_id": "6f1c2a44-8a3d-4f6e-9c21-5b8f0d7e3a19",
      "migrations_dir": "db"
    }
  ],
  "observability": {
    "enabled": true
  }
}
